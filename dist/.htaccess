Options -Indexes
RewriteEngine On

<FilesMatch "(?:^\..*|\.(?:sql|zip|tar|gz|log|bak)$)">
  Require all denied
</FilesMatch>

# Keep configuration, database exports, archives, and old backups private.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^_Backup(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|zip|tar|gz|log|bak)$ - [F,L,NC]

# Let the PHP API and real static files/directories pass through unchanged.
RewriteRule ^api(?:/|$) - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send client-side routes such as /admin/ to the Vite application.
RewriteRule ^ index.html [L]
