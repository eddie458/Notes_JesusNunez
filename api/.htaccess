RewriteEngine On

Options -Indexes
<FilesMatch "(?:^\..*|\.(?:sql|zip|tar|gz|log|bak)$)">
  Require all denied
</FilesMatch>

# Only the controller is an HTTP entry point. Includes still work internally.
<FilesMatch "^(?!index\.php$).*\.php$">
  Require all denied
</FilesMatch>

# Send API routes such as /api/auth/login to the PHP controller while allowing
# the controller itself to be served normally.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
